{
  "name": "nomination-eta-cap",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "@cap-js/sqlite": "^3"
  },
  "devDependencies": {},
  "scripts": {
    "start": "cds deploy && cds-serve",
    "build": "npm run build --workspace=app/react-ui && cds build --production"
  },
  "private": true,
  "cds": {
    "folders": {
      "app": "app/react-ui/dist"
    },
    "[development]": {
      "requires": {
        "auth": "dummy",
        "db": {
          "kind": "sqlite",
          "credentials": { "url": ":memory:" }
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": "dummy",
        "db": {
          "kind": "sqlite",
          "credentials": { "url": "db.sqlite" }
        },
        "OGS_S4": {
          "kind": "rest",
          "destination": "OGS_S4"
        }
      }
    }
  },
  "workspaces": [
    "app/react-ui"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
